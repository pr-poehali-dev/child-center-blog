{
  "tests": [
    {
      "name": "Subscribe duplicate email",
      "method": "POST",
      "path": "/",
      "body": {"name": "Тест Тестов", "email": "test_subscriber_x7z9@example.com"},
      "expectedStatus": 409,
      "bodyMatcher": "partial"
    },
    {
      "name": "Unsubscribe with invalid token",
      "method": "GET",
      "path": "/?unsubscribe=invalidtoken000",
      "expectedStatus": 404,
      "bodyMatcher": "partial"
    },
    {
      "name": "Subscribe missing fields",
      "method": "POST",
      "path": "/",
      "body": {"name": ""},
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Subscribe honeypot filled — silently accepted, not saved",
      "method": "POST",
      "path": "/",
      "body": {"name": "Spam Bot", "email": "spam_bot_honeypot@example.com", "company": "acme"},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "Subscribe too fast — silently accepted, not saved",
      "method": "POST",
      "path": "/",
      "body": {"name": "Fast Bot", "email": "fast_bot_timing@example.com", "form_loaded_at": 99999999999999},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    }
  ]
}